rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isGuardian() {
      return isAuthenticated() && (
        request.auth.token.role == 'guardian' ||
        request.resource.data.role == 'guardian'
      );
    }

    // SOS Alerts Collection - Emergency workflow
    match /sos_alerts/{alertId} {
      // Any authenticated user or app client can read active alerts
      allow read: if true;

      // Create SOS alert: Must start in 'pending' status with escalationTriggered = false
      allow create: if request.resource.data.status == 'pending'
                    && request.resource.data.escalationTriggered == false
                    && request.resource.data.escalationDeadline != null;

      // Update: Guardian can acknowledge the alert before escalation
      // Clients CANNOT set status to 'escalated' directly (handled exclusively by Cloud Functions)
      allow update: if request.resource.data.status == 'acknowledged'
                    && resource.data.status == 'pending'
                    && request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['status', 'acknowledgedAt', 'acknowledgedBy']);

      // Disallow client deletions for audit trail preservation
      allow delete: if false;
    }

    // Default deny for other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
