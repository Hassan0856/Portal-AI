<?xml version="1.0" encoding="utf-8"?>
<!-- Release builds (Codemagic) remove resources the code doesn't reference
     directly. Keep the SOS alarm sound and the notification icon, otherwise
     the SOS notification can silently fail (flutter_local_notifications README). -->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@raw/sos_alarm,@mipmap/ic_launcher" />
